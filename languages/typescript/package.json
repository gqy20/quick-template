{
  "name": "{{ package_name }}",
  "version": "{{ version_escaped }}",
  "description": "{{ description_escaped }}",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "{{#if add_api}}tsx watch src/server.ts{{#else}}tsx src/cli.ts{{#endif}}",
    "build": "tsup src/index.ts{{#if add_api}} src/server.ts{{#else}} src/cli.ts{{#endif}} --format esm --clean && tsc --declaration --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
{{#if with_publish}}
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+{{ repository_provider_escaped }}/{{ repository_username_escaped }}/{{ project_slug }}.git"
  },
{{#endif}}
  "keywords": [],
  "author": "{{ author_name_escaped }} <{{ author_email_escaped }}>",
  "license": "{{ license }}",
  "packageManager": "pnpm@10.34.9",
  "dependencies": {{#if add_api}}{
    "@hono/node-server": "^1.19.6",
    "hono": "^4.7.0"
  }{{#else}}{}{{#endif}},
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
