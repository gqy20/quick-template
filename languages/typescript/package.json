{
  "name": "{{ package_name }}",
  "version": "{{ version }}",
  "description": "{{ description }}",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --clean && tsc --declaration --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "keywords": [],
  "author": "{{ author_name }} <{{ author_email }}>",
  "license": "{{ license }}",
  "packageManager": "pnpm@10.34.9",
  "dependencies": {{#if add_api}}{
    "hono": "^4.7.0"
  }{{#else}}{}{{#endif}},
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
